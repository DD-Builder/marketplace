# --- Secrets ---
# Your Anthropic API key. Required for triage + appraisal.
ANTHROPIC_API_KEY=

# Path to a warmed-up Facebook burner-account session file (Playwright storage_state
# JSON). Leave blank to scrape logged-out only. Create it by logging in once manually
# and saving storage_state — see README. NEVER put a raw password here.
FB_SESSION_PATH=

# --- Models ---
TRIAGE_MODEL=claude-haiku-4-5
APPRAISE_MODEL=claude-opus-4-8
NEGOTIATION_MODEL=claude-opus-4-8

# --- Economics (used by the deterministic deal-score formula) ---
# Your labour value per hour, in cents. Restoration effort is penalised at this rate.
HOURLY_RATE_CENTS=3000
# Max Opus vision appraisals per scrape cycle — bounds spend on broad targets.
MAX_APPRAISALS_PER_RUN=25

# --- Scraper / pacing ---
# Global cap on scraper actions per hour across all identities (the main ban lever).
RATE_MAX_ACTIONS_PER_HOUR=60
# Human-like think-time bounds between actions, in seconds.
PACING_MIN_SECONDS=1.5
PACING_MAX_SECONDS=6.0
# Run the browser headed (recommended for stealth) or headless.
HEADLESS=false
# Chrome channel patchright launches ("chrome" = the real installed build).
BROWSER_CHANNEL=chrome
# Max scroll pages per search before giving up.
MAX_SEARCH_PAGES=10
# Optional quiet hours (local 24h). Empty = always on.
QUIET_HOURS_START=
QUIET_HOURS_END=

# --- Infra ---
DATABASE_URL=sqlite:///data/app.db
PHOTO_DIR=data/photos
SESSION_DIR=data/sessions
