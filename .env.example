# Only needed if you set APPRAISER_PROVIDER=claude-api and want to pay per token
# (requires `pip install 'dealfinder[api]'`). The default path (claude-code) uses your
# Claude subscription via the Claude Code CLI and needs no key at all — see the README.
ANTHROPIC_API_KEY=

# claude-code (subscription, default) | claude-api (metered).
# openai/gemini/grok are declared seams — they raise "not yet implemented" until wired.
APPRAISER_PROVIDER=claude-code

# Optional model pins. Empty = the provider's default. On the claude-code path these are
# passed to the CLI as --model; on the metered path they select the API model.
# Appraisal reads photographs, so it gets the stronger model by default.
APPRAISE_MODEL=claude-opus-5
NEGOTIATION_MODEL=claude-sonnet-5

# Everything else the pipeline needs is a GitHub Actions secret or repository variable,
# not a local .env file. See the README's setup table.
