# Only needed if you set APPRAISER_PROVIDER=claude-api and want to pay per token.
# The default path (claude-code) uses your Claude subscription via the Claude Code CLI
# and needs no key at all — see the README.
ANTHROPIC_API_KEY=

# claude-code (subscription, default) | claude-api (metered) | openai/gemini/grok (seams)
APPRAISER_PROVIDER=claude-code

APPRAISE_MODEL=claude-opus-4-8
NEGOTIATION_MODEL=claude-opus-4-8

# Everything else the pipeline needs is a GitHub Actions secret or repository variable,
# not a local .env file. See the README's setup table.
